{
  "hooks": {
    "SessionStart": [
      { "hooks": [ { "type": "command", "name": "sea-knowledge-check", "command": "python3 \"$GEMINI_PROJECT_DIR/senior-engineering-agent/adapters/hooks/sea_hooks.py\" session-start --runtime gemini-cli" } ] }
